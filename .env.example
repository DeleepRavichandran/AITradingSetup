# Copy to .env (git-ignored). Never commit real values.

# --- Safety: live order routing. Leave false. Only a human operator may change it. ---
LIVE_TRADING_ENABLED=false
# Secret used by the human-controlled promotion CLI to sign strategy approvals.
# Must NOT be present in the environment of research/agent/sandbox processes.
HUMAN_APPROVAL_SECRET=

# --- API ---
# REQUIRED (>= 24 chars): python -c "import secrets; print(secrets.token_urlsafe(32))"
NSEQL_API_TOKEN=
# Shared secret between the API and the separate sandbox worker (Docker deployment); 24+ random characters.
NSEQL_SANDBOX_TOKEN=
# Optional read-only token (GET only) for viewers
NSEQL_VIEWER_TOKEN=
# Single-user machine only: serve loopback clients without a token. Never set this on a server.
# NSEQL_ALLOW_INSECURE_LOCAL=true
NSEQL_DATA_DIR=datasets
NSEQL_EXPERIMENTS_DIR=experiments

# --- Optional: LLM-backed agents (rule-based agents are used when unset) ---
ANTHROPIC_API_KEY=

# --- Optional: broker market data / paper connectivity ---
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is optional: `nseql kite-login` stores the daily token in experiments/kite_session.json

# --- Angel One SmartAPI (free for Angel One clients): automatic daily login, data and live 1-minute screening.
#     scripts\windows\setup.ps1 asks for these once. The TOTP secret is the text shown under the QR code when
#     you enable SmartAPI two-factor authentication. Treat all four like passwords.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# angelone = start live screening + paper trading automatically when the API starts (simulated orders only)
NSEQL_LIVE_SCREENING=
# Starting capital of the live PAPER account (simulated money; default 1000000). A new amount opens a fresh
# paper account in experiments/screening/live_angelone_<amount>; the previous account is kept.
NSEQL_PAPER_CAPITAL=
# Optional: name a new paper account explicitly to start from scratch again with the same capital.
NSEQL_LIVE_RUN=

# --- Optional: WhatsApp alerts (WhatsApp Business Cloud API). See services/notify/whatsapp.py ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_API_VERSION=v21.0

# --- Paper-trading scheduler: background clock for paper sessions (never places real orders).
#     Load the NSE holiday list with `nseql holidays <file.csv> --source "<NSE circular>"` (stored in experiments/holidays.json).
NSEQL_SCHEDULER=false

# --- Dashboard deployment (infra/docker-compose.yml) ---
NSEQL_DOMAIN=
