# Copy to .env (git-ignored). Never commit real values.

# --- Safety: live order routing. Leave false. Only a human operator may change it. ---
LIVE_TRADING_ENABLED=false
# Secret used by the human-controlled promotion CLI to sign strategy approvals.
# Must NOT be present in the environment of research/agent/sandbox processes.
HUMAN_APPROVAL_SECRET=

# --- API ---
# REQUIRED (>= 24 chars): python -c "import secrets; print(secrets.token_urlsafe(32))"
NSEQL_API_TOKEN=
# Optional read-only token (GET only) for viewers
NSEQL_VIEWER_TOKEN=
# Single-user machine only: serve loopback clients without a token. Never set this on a server.
# NSEQL_ALLOW_INSECURE_LOCAL=true
NSEQL_DATA_DIR=datasets
NSEQL_EXPERIMENTS_DIR=experiments

# --- Optional: LLM-backed agents (rule-based agents are used when unset) ---
ANTHROPIC_API_KEY=

# --- Optional: broker market data / paper connectivity ---
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is optional: `nseql kite-login` stores the daily token in experiments/kite_session.json

# --- Optional: WhatsApp alerts (WhatsApp Business Cloud API). See services/notify/whatsapp.py ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_API_VERSION=v21.0

# --- Paper-trading scheduler: background clock for paper sessions. Optional file experiments/holidays.json
#     ({"source": "NSE circular ...", "holidays": ["2026-01-26", ...]}) supplies exchange holidays.
NSEQL_SCHEDULER=false

# --- Dashboard deployment (infra/docker-compose.yml) ---
NSEQL_DOMAIN=
